<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Brush x:Key="Background">#0B0B0C</Brush>
    <Brush x:Key="Foreground">#FFFFFF</Brush>
    <Brush x:Key="Card">#111111</Brush>
    <Brush x:Key="CardForeground">#FFFFFF</Brush>
    <Brush x:Key="Popover">#141414</Brush>
    <Brush x:Key="PopoverForeground">#FFFFFF</Brush>
    <Brush x:Key="Primary">#FF4D5A</Brush>
    <Brush x:Key="PrimaryForeground">#FFFFFF</Brush>
    <Brush x:Key="Secondary">#1B1B1B</Brush>
    <Brush x:Key="SecondaryForeground">#FFFFFF</Brush>
    <Brush x:Key="Muted">#141414</Brush>
    <Brush x:Key="MutedForeground">#888888</Brush>
    <Brush x:Key="Accent">#FF4D5A</Brush>
    <Brush x:Key="AccentForeground">#FFFFFF</Brush>
    <Brush x:Key="Destructive">#FF3B30</Brush>
    <Brush x:Key="DestructiveForeground">#FFFFFF</Brush>
    <Brush x:Key="Border">#22FFFFFF</Brush>
    <Brush x:Key="Input">#141414</Brush>
    <Brush x:Key="Ring">#FF4D5A</Brush>
</ResourceDictionary>
