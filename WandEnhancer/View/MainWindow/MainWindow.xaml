<Window x:Class="WandEnhancer.View.MainWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WandEnhancer.View.MainWindow"
        xmlns:controls="clr-namespace:WandEnhancer.View.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainWindowVm}"
        Title="WandEnhancer"
        Height="560" MaxHeight="560"
        Width="780" MaxWidth="780" 
        Opacity="1"
        Background="Transparent"
        WindowStyle="None"
        FontFamily="{StaticResource Inter}"
        AllowsTransparency="True">
    <Window.Resources>
        <Storyboard x:Key="BlinkAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0.3" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    <Border CornerRadius="18" Background="#0B0B0C"
            BorderBrush="#22FF4D5A"
            BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90"
                              RenderingBias="Quality" ShadowDepth="2"/>
        </Border.Effect>
                
        <Grid>
            <Grid Background="Transparent" VerticalAlignment="Top"
                  MouseLeftButtonDown="OnDragMove" Height="55">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="25 0 0 0">
                    <Viewbox VerticalAlignment="Center" Width="32" Height="32">
                        <Path 
                            Fill="White" Data="{StaticResource Logo}"/>
                    </Viewbox>
                    <TextBlock Foreground="#FFFFFF"
                               FontWeight="Bold" Opacity="1"
                               VerticalAlignment="Center"
                               FontSize="18" Margin="10 0 0 0">
                        WandEnhancer
                    </TextBlock>
                    <TextBlock x:Name="VersionLabel" VerticalAlignment="Bottom"
                               Opacity="0.7" FontSize="10" Margin="5 0 0 5"
                               Foreground="#888888">
                        v 1.0.0
                    </TextBlock>
                    
                </StackPanel>
                                
                <StackPanel  HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        Margin="0 0 5 0"
                        Width="30" Height="30" Padding="5.5"
                        Style="{StaticResource IconButton}"
                        Tag="{StaticResource CogIcon}"
                        Command="{Binding OpenSettingsCommand}"
                        />
                    <Button Click="OnClosing" Width="30" Height="30" Cursor="Hand" Margin="5 0 15 0" BorderThickness="0" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="0">
                                    <TextBlock Text="✕" Foreground="#888888" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#22FF3B30"/>
                                        <Setter Property="Foreground" Value="#FF3B30"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#33FF3B30"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <Border Background="#22FFFFFF" Height="1" VerticalAlignment="Bottom"></Border>
                                
            </Grid>
            <Grid Margin="0 55 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="10" Cursor="Hand" Background="Transparent"
                      PreviewMouseLeftButtonDown="OnFolderClick">
                    <TextBox Style="{StaticResource TitledTextBox}"
                             IsReadOnly="True"
                             Text="{Binding WeModInfo.RootDirectory, Mode=OneWay}"
                             VerticalAlignment="Center">
                    </TextBox>
                </Grid>

                    
                    <Border Grid.Row="1" BorderBrush="#22FFFFFF" BorderThickness="1"
                            Margin="10 0 10 10"
                            CornerRadius="12">
                        <Grid>
                            <ListBox ItemsSource="{Binding LogList}" SelectionMode="Single"
                                 BorderBrush="Transparent" BorderThickness="0"
                                 Background="Transparent" 
                                 x:Name="LogList"
                                 Padding="6"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Margin" Value="0 0 0 5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" HorizontalAlignment="Left"
                                            Background="#1a6b3a"
                                            BorderBrush="{DynamicResource Border}"
                                            Padding="5 3 5 3" CornerRadius="6">
                                         <TextBox x:Name="LogText" Text="{Binding Message}" 
                                                 Cursor="IBeam" FontSize="13"
                                                 Foreground="#FFFFFF"
                                                 Background="Transparent" TextWrapping="Wrap"
                                                 BorderThickness="0"
                                                 IsReadOnly="True"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding LogType}" Value="Error">
                                            <Setter  TargetName="Card" Property="Background" Value="#FF3B30"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogType}" Value="Info">
                                            <Setter  TargetName="Card" Property="Background" Value="#1a1a00"></Setter>
                                            <Setter  TargetName="LogText" Property="Foreground" Value="#FFD700"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogType}" Value="Warn">
                                            <Setter  TargetName="Card" Property="Background" Value="#FFCC00"></Setter>
                                            <Setter  TargetName="LogText" Property="Foreground" Value="#000000"></Setter>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0 4 4 0">
                                <Button Width="22" Height="22" Padding="4"
                                        Style="{StaticResource IconButton}"
                                        Tag="{StaticResource CopyIcon}"
                                        ToolTip="{DynamicResource mw_copy_logs}"
                                        Command="{Binding CopyLogsCommand}"/>
                                <Button Width="22" Height="22" Padding="4" Margin="4 0 0 0"
                                        Style="{StaticResource IconButton}"
                                        Tag="{StaticResource ExportIcon}"
                                        ToolTip="{DynamicResource mw_export_logs}"
                                        Command="{Binding ExportLogsCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                


                <Grid Grid.Row="2" Margin="10 0 10 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: GitHub + author -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" 
                                Cursor="Hand" 
                                MouseDown="OpenSourceClicked" 
                                Background="Transparent">
                        <Viewbox VerticalAlignment="Center" Width="32" Height="32">
                            <Path 
                                Fill="White" Data="{StaticResource GitHub}"/>
                        </Viewbox>
                        <StackPanel Margin="8 0 0 0" VerticalAlignment="Center">
                            <TextBlock FontSize="10" Foreground="#888888">
                                <Run Text="{DynamicResource mw_source_code}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource mw_made_by}"/>
                                <LineBreak/>
                                <Run Text="{DynamicResource mw_star_hint}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                <TextBlock FontSize="10" Foreground="#888888" VerticalAlignment="Center">
                                    <Run Text="by "/>
                                </TextBlock>
                                <TextBlock x:Name="CharlotteLink" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                           Cursor="Hand" MouseLeftButtonDown="OnCharlotteClick">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#00FF66"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource BlinkAnimation}"/>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                    <Run Text="charlotte-zee"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Patch/Restore/Launch button -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid HorizontalAlignment="Right" >
                            <Grid.Style>
                                <Style TargetType="{x:Type Grid}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPatchEnabled}" Value="False">
                                            <Setter Property="Cursor" Value="No"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Button Style="{StaticResource ColoredButton}"
                                    IsEnabled="{Binding IsPatchEnabled}"
                                    FontWeight="Bold" FontSize="16" Width="200" 
                                    Command="{Binding ApplyPatchCommand}"
                                    Content="{DynamicResource mw_patch}"/>
                        </Grid>
                        <Button HorizontalAlignment="Right"
                                Command="{Binding RestoreBackupCommand }"
                                FontWeight="Bold" FontSize="16" Width="200" 
                                Style="{StaticResource ColoredButton}"
                                Visibility="{Binding AlreadyPatched, Converter={StaticResource ToVisibilityConverter}}"
                                Content="{DynamicResource mw_restore}"/>
                        <Button HorizontalAlignment="Right" Margin="0 0 210 0"
                                Command="{Binding LaunchCommand}"
                                FontWeight="Bold" FontSize="16" Width="200"
                                Background="#FF1A6B3A" Foreground="White" BorderThickness="0"
                                Cursor="Hand"
                                Visibility="{Binding AlreadyPatched, Converter={StaticResource ToVisibilityConverter}}"
                                Content="Launch"/>
                    </Grid>
                </Grid>
            </Grid>
            
            <controls:PopupHost x:Name="PopupHost"/>
        </Grid>
    </Border>
</Window>
