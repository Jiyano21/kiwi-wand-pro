<UserControl x:Class="WandEnhancer.View.Popups.PatchVectorsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WandEnhancer.View.Popups"
             xmlns:controls="clr-namespace:WandEnhancer.View.Controls"
             mc:Ignorable="d"
             d:DesignHeight="Auto" d:DesignWidth="Auto"
             Background="#0B0B0C"
             Foreground="#888888"
             FontWeight="Medium"
             FontSize="13">
    <Grid MinWidth="430">
        <Grid Visibility="Visible" Margin="0 0 5 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource pv_activate_pro}" Foreground="#FFFFFF"/>
            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ActivateProBox" HorizontalAlignment="Right" VerticalAlignment="Center"
                      IsChecked="True" />

            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource pv_devtools}" Foreground="#FFFFFF"/>
            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="DevToolsHotkeyBox" HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource pv_disable_updates}" Foreground="#FFFFFF"/>
            <CheckBox Grid.Row="2" Grid.Column="1" x:Name="DisableUpdateBox" HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource pv_remote_web_panel_preview}" Foreground="#FFFFFF"/>
            <CheckBox Grid.Row="3" Grid.Column="1" x:Name="RemoteWebPanelPreviewBox" HorizontalAlignment="Right" VerticalAlignment="Center" />

            <Border Grid.Row="4" Grid.ColumnSpan="2" Margin="0 14 0 0" Padding="15"
                    BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12"
                    Background="#111111">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="#FFFFFF"
                                   Text="{DynamicResource pv_custom_scripts}" />
                        <Button Grid.Column="1" Padding="15,10" Content="{DynamicResource pv_add_js_scripts}"
                                Style="{StaticResource ColoredButton}"
                                Click="OnAddScriptClick" />
                    </Grid>

                    <TextBlock Margin="0 10 0 0" FontSize="11" TextWrapping="Wrap"
                               Opacity="0.8"
                               Foreground="#888888"
                               Text="{DynamicResource pv_custom_scripts_hint}" />

                    <ItemsControl x:Name="ScriptList" Margin="0 4 0 0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0 8 8 0" Padding="12,8"
                                        Background="#141414"
                                        BorderBrush="#22FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Tag="{Binding}" Content="✕"
                                                BorderThickness="0" Padding="8,2" Margin="10,0,0,0"
                                                Foreground="#FF3B30"
                                                Click="OnRemoveScriptClick" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="#FFFFFF"
                                                   Text="{Binding FileName}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoScriptsText" Margin="0 10 0 0" FontSize="11"
                               Opacity="0.7"
                               Foreground="#888888"
                               Text="{DynamicResource pv_no_custom_scripts}" />
                </StackPanel>
            </Border>

            <Button Grid.Row="5" Grid.ColumnSpan="2" Padding="0,14,0,14" Margin="0 15 0 10" Content="{DynamicResource pv_start}"
                    Style="{StaticResource ColoredButton}"
                    FontSize="16" FontWeight="Bold" Width="200"
                    Click="OnPatchButtonClick" />
        </Grid>
    </Grid>

</UserControl>
