<Window x:Class="WandEnhancer.View.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiwi Wand Pro - License"
        Width="420" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FF0B0B0C"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF111111"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFFF4D5A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFCCCCCC"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#FF666666"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#FF333333"/>
    </Window.Resources>

    <Border x:Name="WindowBorder" Background="{StaticResource BackgroundBrush}"
            BorderBrush="#FF222222" BorderThickness="1"
            CornerRadius="12" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Height="36" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Kiwi" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text=" Wand" Foreground="{StaticResource AccentBrush}"
                               FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text=" Pro" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Width="30" Height="30"
                        Background="Transparent" BorderThickness="0"
                        Click="BtnClose_Click" Cursor="Hand"
                        Margin="0,0,8,0">
                    <TextBlock Text="&#x2715;" Foreground="#FF666666" FontSize="14"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="28,0,28,16">
                <!-- Icon -->
                <TextBlock Text="&#x1F511;" FontSize="32" HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Enter your credentials to activate"
                           Foreground="{StaticResource SubtextBrush}"
                           FontSize="12" HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- USERNAME Label -->
                <TextBlock Text="USERNAME" Foreground="{StaticResource SubtextBrush}"
                           FontSize="10" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <!-- USERNAME Input -->
                <TextBox x:Name="TxtUsername"
                         Height="38"
                         Background="{StaticResource CardBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                         FontSize="13" Padding="12,0"
                         VerticalContentAlignment="Center"
                         CaretBrush="{StaticResource AccentBrush}"
                         MaxLength="50"/>

                <Grid Height="12"/>

                <!-- LICENSE KEY Label -->
                <TextBlock Text="LICENSE KEY" Foreground="{StaticResource SubtextBrush}"
                           FontSize="10" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <!-- LICENSE KEY Input -->
                <Grid>
                    <PasswordBox x:Name="TxtLicenseKey"
                                 Height="38"
                                 Background="{StaticResource CardBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                 FontSize="13" Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 CaretBrush="{StaticResource AccentBrush}"
                                 MaxLength="50"/>
                    <TextBox x:Name="TxtLicenseKeyVisible"
                             Height="38"
                             Background="{StaticResource CardBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                             FontSize="13" Padding="12,0"
                             VerticalContentAlignment="Center"
                             CaretBrush="{StaticResource AccentBrush}"
                             MaxLength="50"
                             Visibility="Collapsed"/>
                </Grid>

                <!-- Status Message -->
                <TextBlock x:Name="TxtStatus"
                           Foreground="#FFFF3B30"
                           FontSize="11" TextAlignment="Center"
                           Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Bottom Button -->
            <Grid Grid.Row="2" Margin="28,0,28,20">
                <Button x:Name="BtnActivate"
                        Height="40" Width="160"
                        HorizontalAlignment="Center"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnActivate_Click"
                        Padding="0" VerticalContentAlignment="Center">
                    <TextBlock x:Name="BtnActivateText" Text="ACTIVATE"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
